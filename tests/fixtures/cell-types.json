        {
          "id": "http://purl.obolibrary.org/obo/CL_0011115",
          "lbl": "precursor cell",
          "type": "CLASS",
          "meta": {
            "definition": {
              "val": "A cell that, by division or terminal differentiation, can give rise to other cell types.",
              "xrefs": [
